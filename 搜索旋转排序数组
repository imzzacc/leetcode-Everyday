class Solution {
    public int search(int[] nums, int target) {
        int left=0;
        int right=nums.length-1;
        while(left<=right){
            int mid=left+(right-left)/2;
            if(nums[mid]==target){
                return mid;
            }
            if(nums[left]<=nums[mid]){//判断左半边是否有序
                if(nums[left]<=target&&target<=nums[mid]){
                    //左半边有序并且目标值在左半边
                    right=mid-1;
                }else{
                    //左半边有序但目标只在右半边
                    left=mid+1;
                }
            }else{
                if(nums[mid]<=target&&target<=nums[right]){
                    left=mid+1;
                }else{
                    right=mid-1;
                }
            }
        }
        return -1;
    }
}
