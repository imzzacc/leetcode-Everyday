class Solution {
    public int findMin(int[] nums) {
        int n=nums.length;
        int left=-1;
        int right=n-1;
        while(left+1<right){
            int mid=(left+right)>>>1;
            if(nums[mid]<nums[n-1]){
                right=mid;
            }else{
                left=mid;
            }
        }
        return nums[right];
    }
}
