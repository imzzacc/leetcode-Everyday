/**
 * Definition for a binary tree node.
 * public class TreeNode {
 *     int val;
 *     TreeNode left;
 *     TreeNode right;
 *     TreeNode() {}
 *     TreeNode(int val) { this.val = val; }
 *     TreeNode(int val, TreeNode left, TreeNode right) {
 *         this.val = val;
 *         this.left = left;
 *         this.right = right;
 *     }
 * }
 */
class Solution {
    public TreeNode buildTree(int[] preorder, int[] inorder) {
        int n=preorder.length;
        if(n==0){
            return null;
        }
        int leftSize=index(inorder,preorder[0]);
        int[] in1=Arrays.copyOfRange(inorder,0,leftSize);
        int[] in2=Arrays.copyOfRange(inorder,leftSize+1,n);
        int[] pre1=Arrays.copyOfRange(preorder,1,leftSize+1);
        int[] pre2=Arrays.copyOfRange(preorder,leftSize+1,n);
        TreeNode left=buildTree(pre1,in1);
        TreeNode right=buildTree(pre2,in2);
        return new TreeNode(preorder[0],left,right);
    }
    private int index(int[] a,int x){
        for(int i=0; ;i++){
            if(a[i]==x){
                return i;
            }
        }
    }
}
