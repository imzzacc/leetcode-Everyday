class Solution {
    public int orangesRotting(int[][] grid) {
        int m=grid.length;
        int n=grid[0].length;
        int time=0;
        int[][] direction={{1,0},{-1,0},{0,1},{0,-1}};
        Queue<int[]> queue=new LinkedList<>();
        for(int i=0;i<m;i++){
            for(int j=0;j<n;j++){
                if(grid[i][j]==2){
                    queue.offer(new int[]{i,j,0});
                }
            }
        }
        while(!queue.isEmpty()){
            int[] cur=queue.poll();
            int i=cur[0];
            int j=cur[1];
            time=cur[2];
            for(int[] dir:direction){
                int newI=i+dir[0];
                int newJ=j+dir[1];
                if(newI>=0&&newI<m&&newJ>=0&&newJ<n&&grid[newI][newJ]==1){
                    grid[newI][newJ]=2;
                    queue.offer(new int[]{newI,newJ,time+1});
                }
            }
        }
        for(int i=0;i<m;i++){
            for(int j=0;j<n;j++){
                if(grid[i][j]==1){
                    return -1;
                }
            }
        }
        return time;
    }
}
