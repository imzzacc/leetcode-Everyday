class Solution {
    public boolean isValid(String s) {
        if(s.length()%2!=0){
            return false;
        }
        Map<Character,Character> map=new HashMap<>(){
            {
                put(')','(');
                put(']','[');
                put('}','{');
            }
        };
        Deque<Character> dq=new ArrayDeque<>();
        for(char c:s.toCharArray()){
            if(!map.containsKey(c)){
                dq.push(c);
            }else{
                if(dq.isEmpty()){
                    return false;
                }
                char left=dq.pop();
                if(left!=map.get(c)){
                    return false;
                }
            }
        }
        return dq.isEmpty();
    }
}
